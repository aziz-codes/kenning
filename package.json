{
  "name": "kenning",
  "displayName": "Kenning — Understand the code your AI writes",
  "description": "While Claude Code or any coding agent works, Kenning turns its changes into quick review cards: what changed, risky edits flagged, one quick question — and a one-click flag the agent fixes before it finishes.",
  "version": "0.1.0",
  "publisher": "azizcodes",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16130f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Education",
    "Other"
  ],
  "keywords": [
    "claude code",
    "ai",
    "code review",
    "comprehension",
    "agents",
    "codex",
    "cursor",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kenning",
          "title": "Kenning",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "kenning": [
        {
          "type": "webview",
          "id": "kenning.deck",
          "name": "Review"
        }
      ]
    },
    "commands": [
      {
        "command": "kenning.connectClaude",
        "title": "Connect to Claude Code",
        "category": "Kenning"
      },
      {
        "command": "kenning.disconnectClaude",
        "title": "Disconnect from Claude Code",
        "category": "Kenning"
      },
      {
        "command": "kenning.reviewUncommitted",
        "title": "Review uncommitted changes",
        "category": "Kenning"
      },
      {
        "command": "kenning.focus",
        "title": "Open review deck",
        "category": "Kenning"
      },
      {
        "command": "kenning.setApiKey",
        "title": "Set Anthropic API key",
        "category": "Kenning"
      },
      {
        "command": "kenning.clearApiKey",
        "title": "Remove Anthropic API key",
        "category": "Kenning"
      },
      {
        "command": "kenning.resetStats",
        "title": "Reset understanding stats",
        "category": "Kenning"
      }
    ],
    "configuration": {
      "title": "Kenning",
      "properties": {
        "kenning.ai.provider": {
          "type": "string",
          "enum": [
            "auto",
            "claudeCode",
            "anthropicApi",
            "off"
          ],
          "enumDescriptions": [
            "Use Claude Code if it is installed, otherwise an Anthropic API key if one is set.",
            "Use your local Claude Code (your plan, nothing extra to configure).",
            "Use an Anthropic API key (set it with “Kenning: Set Anthropic API key”).",
            "No AI: cards show the change and risk flags, and you mark them as understood."
          ],
          "default": "auto",
          "description": "Where Kenning gets plain-English summaries and quick questions about each change."
        },
        "kenning.ai.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Model used for summaries and questions."
        },
        "kenning.ai.prefetch": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "How many upcoming cards to prepare in advance while the agent works."
        },
        "kenning.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude Code executable."
        },
        "kenning.watchExternalChanges": {
          "type": "boolean",
          "default": true,
          "description": "Create cards for files changed outside the editor (Codex, Aider, Copilot agent, scripts). Git operations such as checkout are ignored."
        },
        "kenning.notifyOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the agent finishes and changes are waiting."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "test:e2e": "npm run build && KENNING_E2E=1 vitest run test/e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
